    "version": "0.2.0",
    "configurations": [
        {
            "name": "app_movil",
            "cwd": "app_movil",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "app_movil (profile mode)",
            "cwd": "app_movil",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "app_movil (release mode)",
            "cwd": "app_movil",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        /* =========================
           🔥 DEPURACIÓN PHP BACKEND
           ========================= */
        {
            "name": "Debug PHP Backend",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "C:\\xampp\\htdocs\\personal\\venmobile": "${workspaceFolder}"
            }
        }
    ],
    "compounds": [
        {
            "name": "Flutter & PHP",
            "configurations": [
                "app_movil",
                "Debug PHP Backend"
            ]
        }
    ]
}